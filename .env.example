# Dry Run Environment Configuration Example
# Copy to .env for local development

# Database
DATABASE_URL=sqlite:///./dev.db

# LLM Provider Configuration
LLM_PROVIDER=openai_compatible
LLM_MODEL_PRIMARY=gpt-4o
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_API_KEY=mock-key-for-local-dev
DAILY_LLM_BUDGET_USD=5.00

# Feature Flags
LLM_ENABLED=false
VOICE_ENABLED=false

# Service Limits and Policies
RETENTION_DAYS=7
TRUSTED_PROXY_COUNT=1
