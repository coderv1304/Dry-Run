# Dry Run backend environment example.
# Copy to .env for local development. Never commit real secrets.

# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./dryrun.db
TOKEN_PEPPER=replace-with-at-least-32-random-characters
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true

# Feature flags
LLM_ENABLED=false
VOICE_ENABLED=false

# LLM provider (only used when LLM_ENABLED=true)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_PRIMARY=gpt-4o-mini
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_TIMEOUT_SECONDS=1.5
LLM_RESCORE_TIMEOUT_SECONDS=8.0
LLM_MAX_OUTPUT_TOKENS=120
LLM_RESCORE_MAX_TOKENS=700
LLM_INPUT_COST_PER_MTOK=0.15
LLM_OUTPUT_COST_PER_MTOK=0.60
DAILY_LLM_BUDGET_USD=1.00
LLM_KILL_SWITCH=false

# Drill limits and retention
MAX_TURNS=12
MAX_DURATION_SECONDS=900
IDLE_TIMEOUT_SECONDS=600
MAX_REQUEST_BODY_BYTES=4096
RETENTION_DAYS=7
INVITE_TTL_DAYS=7
SESSION_TTL_DAYS=7
REPORT_TTL_DAYS=7
MAX_SESSIONS_PER_INVITE=3

# Network and abuse controls
TRUSTED_PROXY_COUNT=0
CORS_ORIGINS=https://app.example
INVITE_PER_IP_PER_HOUR=10
INVITE_GLOBAL_DAILY_CAP=100
TURN_PER_IP_PER_MINUTE=60
TURN_PER_TOKEN_PER_MINUTE=30

# Maintenance
PURGE_INTERVAL_SECONDS=300
