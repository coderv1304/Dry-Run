{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioGraphResponse",
  "type": "object",
  "required": [
    "stage_ids",
    "labels"
  ],
  "properties": {
    "stage_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "contact",
          "accusation",
          "isolation",
          "urgency",
          "transfer"
        ]
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "P1",
          "P2",
          "P3",
          "P4",
          "C1",
          "C2",
          "C3",
          "C4"
        ]
      }
    }
  },
  "additionalProperties": false
}